# =========================================================================
# Archivo de ejemplo de variables de entorno (.env.example)
# Copia este archivo como .env antes de arrancar Docker: cp .env.example .env
# =========================================================================

# Configuración básica de Django
DJANGO_SECRET_KEY=password-de-ejemplo # cambia por tu password
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Conexión a Redis (contenedor 'redis' en el puerto estándar 6379)
REDIS_HOST=redis
REDIS_PORT=6379

# Conexión a MongoDB (contenedor 'mongo' en el puerto estándar 27017)
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=flyswap_logs

# Conexión a Neo4j (contenedor 'neo4j' en el puerto Bolt 7687)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password-de-ejemplo # cambia por tu password
